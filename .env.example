# Copy to .env and fill in. The AI GM degrades to a deterministic rules-only
# referee when no provider/key is present, so this is optional for testing the
# engine.

# --- LLM provider ------------------------------------------------------------
# Which backend to use: openrouter (default) | gemini | anthropic.
# Leave unset to auto-detect from whichever API key is present.
SANDCASTLEGM_PROVIDER=openrouter

# --- Google Gemini (free tier, no credit card / no prior purchase) -----------
# Get a key at https://aistudio.google.com/apikey . Then:
#   SANDCASTLEGM_PROVIDER=gemini
#   GEMINI_API_KEY=...
#   SANDCASTLEGM_MODEL=gemini-2.5-flash   # or gemini-2.5-pro, gemini-flash, gemini-pro
GEMINI_API_KEY=

# OpenRouter (https://openrouter.ai) — one OpenAI-compatible endpoint for many
# models. Community testing found mid-size open models (~27B, e.g. Gemma 3 27B)
# make strong TTRPG GMs, so that is the default. Any OpenRouter model id works.
OPENROUTER_API_KEY=
SANDCASTLEGM_MODEL=google/gemma-3-27b-it
# Free models: append ':free' (e.g. google/gemma-3-27b-it:free). NOTE: OpenRouter
# requires a one-time credit purchase (~$10 lifetime) before ':free' models work
# beyond a tiny cap — a brand-new account gets a 402 "insufficient credits" even
# on free models. For a no-cost path, point OPENROUTER_BASE_URL at a local
# OpenAI-compatible server instead (and set OPENROUTER_API_KEY to any value):
#   OPENROUTER_BASE_URL=http://localhost:11434/v1   # Ollama
#   SANDCASTLEGM_MODEL=gemma3:27b
OPENROUTER_BASE_URL=
# Optional OpenRouter attribution headers:
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=SandcastleGM

# Anthropic backend (set SANDCASTLEGM_PROVIDER=anthropic and a Claude model id):
ANTHROPIC_API_KEY=
SANDCASTLEGM_EFFORT=medium

# Inline the full rulebook into the GM system prompt (heavy; needs a large
# context window). Off by default — the ruleset guidance digest is always sent.
SANDCASTLEGM_INCLUDE_RULEBOOK=false

# --- multiplayer server ------------------------------------------------------
SANDCASTLEGM_HOST=127.0.0.1
SANDCASTLEGM_PORT=8765
