# Copy to .env and fill in. The AI GM degrades to a deterministic rules-only
# referee when no API key is present, so this is optional for testing the engine.
ANTHROPIC_API_KEY=

# Model used by the AI Game Master. Opus 4.8 is the default; any current Claude
# model id works.
SANDCASTLEGM_MODEL=claude-opus-4-8

# Effort for the GM model (low | medium | high | xhigh | max).
SANDCASTLEGM_EFFORT=medium

# Multiplayer server bind address.
SANDCASTLEGM_HOST=127.0.0.1
SANDCASTLEGM_PORT=8765
